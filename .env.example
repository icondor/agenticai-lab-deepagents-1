# Modelul folosit de toti agentii (ca in laburile anterioare)
# Valori: anthropic | gemini | openai | ollama | azureopenai | xai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# LangSmith: un singur slide in Lab 15 (trace-ul unui Deep Agent).
# Restul despre LangSmith vine in Lab 17. Trace-urile pleaca in cloud-ul LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=lab15-blog
# Doar pentru cont in regiunea EU:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
